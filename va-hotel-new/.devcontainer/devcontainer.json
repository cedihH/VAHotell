{
  "name": "VA Hotel (Java 21)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": true
    }
  },
  "forwardPorts": [8080],
  "containerEnv": {
    "PORT": "8080"
  },
  "portsAttributes": {
    "8080": {
      "label": "VA Hotel",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash .devcontainer/start-app.sh"
}
